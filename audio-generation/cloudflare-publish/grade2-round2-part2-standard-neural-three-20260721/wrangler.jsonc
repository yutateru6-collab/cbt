{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "grade2-r2-p2-standard-neural-3",
  "main": "./worker.js",
  "compatibility_date": "2026-07-12",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cbt",
  "main": "./cloudflare-worker.js",
  "compatibility_date": "2026-07-12",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "node scripts/prepare-worker-assets.mjs"
  },
  "assets": {
    "directory": "./worker-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "MIMILISTEN_AUDIO",
      "bucket_name": "mimilisten-audio"
    },
    {
      "binding": "CBT_PROJECT_ARCHIVE",
      "bucket_name": "cbt-project-archive"
    }
  ],
  "compatibility_flags": ["nodejs_compat"]
}
